{
  "schemaVersion": 1,
  "id": "pathweaver",
  "version": "${version}",
  "name": "PathWeaver",
  "description": "Experimental off-thread A* for all six vanilla mob evaluators. Ships with compatibility checking OFF, so it runs other mods' uninspected pathfinding code on worker threads — back up your worlds, or set compatibilityTier=AUDITED.",
  "authors": ["Zimdin"],
  "contact": {
    "homepage": "https://modrinth.com/mod/pathweaver",
    "sources": "https://github.com/Zimdin12/PathWeaver",
    "issues": "https://github.com/Zimdin12/PathWeaver/issues"
  },
  "license": "MIT",
  "icon": "assets/pathweaver/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.pathweaver.PathWeaver"],
    "modmenu": ["dev.pathweaver.config.PathWeaverModMenu"]
  },
  "mixins": ["pathweaver.mixins.json"],
  "depends": {
    "minecraft": ">=26.1 <26.3",
    "java": ">=25",
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "cloth-config": ">=26.1"
  },
  "suggests": {
    "lithium": "*",
    "modmenu": "*"
  }
}
